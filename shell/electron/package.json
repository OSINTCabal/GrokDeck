{
  "name": "grokdeck-shell",
  "version": "1.0.0",
  "description": "GrokDeck frameless desktop shell (Electron)",
  "author": "OSINTCabal",
  "homepage": "https://OSINTCabal.org/",
  "desktopName": "grokdeck.desktop",
  "main": "main.js",
  "scripts": {
